# Copy this file to .env and replace EVERY CHANGE_ME value with a unique, strong secret.
# Never commit .env. Set DOLI_URL_ROOT to the exact public HTTPS URL for a remote staging deployment.
DOLIBARR_IMAGE=dolibarr/dolibarr:latest
DB_NAME=empresia
DB_USER=empresia
DB_PASSWORD=CHANGE_ME_USE_RANDOM_LONG_PASSWORD
DOLI_ADMIN_LOGIN=empresiaadmin
DOLI_ADMIN_PASSWORD=CHANGE_ME_USE_ANOTHER_RANDOM_LONG_PASSWORD
DOLI_INSTANCE_UNIQUE_ID=CHANGE_ME_USE_RANDOM_UNIQUE_ID
DOLI_URL_ROOT=http://localhost:8080
DOLI_HOST_PORT=8080
